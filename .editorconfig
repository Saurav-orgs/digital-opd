# One editor baseline for every app in this repo. Mirrors .prettierrc.json;
# change both together.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.dart]
indent_size = 2

[*.py]
indent_size = 4
