# ── Service ──────────────────────────────────────────
AI_HOST=127.0.0.1
AI_PORT=8000

# ── Speech-to-text: which provider ───────────────────
# "sarvam" calls Sarvam's hosted saaras model; "whisper" runs the local
# faster-whisper configured further down. Whisper is off, not removed — flip
# this back and it loads exactly as it did before. On "sarvam" the Whisper
# model is never constructed, so the service starts instantly and gives up
# ~1GB of RAM.
STT_PROVIDER=sarvam

# The key belongs HERE, not in backend-OPD/.env: the backend never
# transcribes, it forwards audio to this service, which is the only process
# that calls Sarvam.
SARVAM_API_KEY=
# saarika:* are all deprecated. saaras:v4 is current and the only one that
# accepts `keyterms` (the clinic's medicine names, up to 50).
SARVAM_MODEL=saaras:v4
# The output mode, and the setting most likely to be got wrong. Measured on a
# code-switched dictation ("mareez ko teen din se bukhar hai, Dolo 650..."):
#   translit    Mareez ko teen din se bukhar hai, Dolo 650 ek goli twice a day
#   codemix     Patient ko teen din se bukhar hai Dolo 650 ek goli twice a day
#   transcribe  मरीज को तीन दिन से बुखार है। डालोड 650 ...
#   verbatim    Patient has fever for three days Dolo six fifty one tablet...
# Only "translit" keeps BOTH Roman script and the doctor's own words, which is
# the contract everything downstream was written against. "verbatim" silently
# translates to English, which would gut previous_history without failing.
SARVAM_MODE=translit
# "unknown" lets Sarvam detect the language, which is what code-switched
# Hinglish needs. Measured against a pinned hi-IN: no difference in latency.
SARVAM_LANGUAGE=unknown
SARVAM_TIMEOUT_SECONDS=20
# How many transcriptions may be in flight. This is a NETWORK call, so do not
# size it like WHISPER_POOL_SIZE — at 1 every doctor and every chunk would
# queue behind one HTTP request.
SARVAM_CONCURRENCY=8
# Fall back to Whisper when Sarvam fails. Off on purpose: a silent fallback
# hides the provider failures worth knowing about, and reloads the 1GB model.
# Turn it on for a box that has to keep working without a network.
STT_FALLBACK_TO_WHISPER=false

# ── Speech-to-text (faster-whisper; used when STT_PROVIDER=whisper) ──
# Demo on this laptop: "small" (~250MB, fastest usable).
# Better Hindi accuracy: "vasista22/whisper-hindi-medium" (~1.5GB).
# On a GPU box: "large-v3" with WHISPER_DEVICE=cuda, WHISPER_COMPUTE_TYPE=float16.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=hi

# How many consultations may transcribe at the same time. 1 = the old
# behaviour, everyone queues behind one model. On a multi-doctor server set 2-3
# (each model costs ~1GB RAM and wants a core or two of its own).
WHISPER_POOL_SIZE=1
# Threads per model; 0 splits the box's cores across the pool.
WHISPER_CPU_THREADS=0
# Leave at 5. Greedy (1) is twice as fast but was measured dropping whole
# dosage sentences from prescription audio.
WHISPER_BEAM_SIZE=5
# Batched decoding: cuts on silence and decodes the pieces together. Same
# weights, 2-4x faster on the same box. Measure with scripts/bench_stt.py
# (run once with each value) before turning it on for a clinic.
WHISPER_BATCHED=false
WHISPER_BATCH_SIZE=8

# GPU profile — on a CUDA box replace the three lines above with:
#   WHISPER_MODEL=large-v3-turbo
#   WHISPER_DEVICE=cuda
#   WHISPER_COMPUTE_TYPE=float16
# (build the image with --build-arg BASE_IMAGE=nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04)

# ── LLM (Ollama) ─────────────────────────────────────
# Ollama is only the last-resort fallback behind Claude and Gemini. Set this
# false on a server where you do not want to install it: /health then stops
# reporting the service degraded over a missing Ollama, and the fallback chain
# skips it instead of failing on a refused connection.
LOCAL_LLM_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b-instruct
LLM_TIMEOUT_SECONDS=300

# Set after running finetune/train_lora.py to serve the fine-tuned adapter.
LORA_ADAPTER_PATH=

# ── Claude / Anthropic (first choice for extraction AND summaries) ───
# With a key set, every LLM call goes to Claude first; Gemini and Ollama stay
# wired underneath as fallbacks, so an outage degrades instead of failing.
AI_CLAUDE_ENABLED=true
ANTHROPIC_API_KEY=
AI_CLAUDE_MODEL=claude-opus-5
# How hard the model thinks before answering. "high" is the default because
# capturing everything the doctor said beats saving a second; "medium"/"low"
# are faster. Summary endpoints always use "high" regardless of this.
# AI_-prefixed to avoid colliding with a CLAUDE_* variable in the shell.
AI_CLAUDE_EFFORT=high
AI_CLAUDE_TIMEOUT_SECONDS=120
AI_CLAUDE_MAX_TOKENS=8000

# Prescription extraction only — the call a doctor waits on with a patient in
# the room. Separate from the summary settings above so this route can be
# tuned for speed without touching the reports. Compare settings with
# scripts/bench_extract.py before changing them.
#   AI_CLAUDE_EXTRACT_EFFORT  low | medium | high   (medium: measured fine for drafts)
#   AI_CLAUDE_EXTRACT_MODEL   blank = AI_CLAUDE_MODEL; e.g. claude-sonnet-5 to A/B
#   AI_CLAUDE_FAST            true = Opus fast mode (~2.5x output speed, 2x price;
#                             ignored on non-Opus models, falls back on 429)
AI_CLAUDE_EXTRACT_EFFORT=medium
AI_CLAUDE_EXTRACT_MODEL=
AI_CLAUDE_EXTRACT_MAX_TOKENS=4000
AI_CLAUDE_FAST=false

# ── Gemini (prescription extraction) ─────────────────
# When true, /extract-prescription calls Gemini instead of the local Ollama model.
# Report summaries and transcription always use local models regardless of this flag.
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── OCR ──────────────────────────────────────────────
OCR_LANGUAGES=eng+hin
MAX_DOCUMENT_CHARS=24000
