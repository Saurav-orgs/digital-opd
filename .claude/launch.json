{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ai",
      "runtimeExecutable": "ai-OPD/.venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--app-dir",
        "ai-OPD"
      ],
      "port": 8000
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:dev",
        "--prefix",
        "backend-OPD"
      ],
      "port": 3000
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "admin-OPD"
      ],
      "port": 5173
    },
    {
      "name": "patient-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "patient-web-OPD"
      ],
      "port": 5175
    }
  ]
}
