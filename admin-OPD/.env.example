# Base URL of the OPD backend API (include the /api prefix, no trailing slash).
# The app calls this directly — there is no Vite proxy.
#
# Local dev:   http://localhost:3000/api
# Dev tunnel:  https://<subdomain>.devtunnels.ms/api
# Production:  https://your-backend.example.com/api
VITE_API_BASE_URL=http://localhost:3000/api
