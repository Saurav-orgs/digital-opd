# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
CLINIC_TIMEZONE=Asia/Kolkata
# Prescription letterhead (all optional — blank clinic name falls back to
# the doctor's name).
CLINIC_NAME=
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_EMAIL=

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# ── SuperAdmin seed ──────────────────────────────────
SUPERADMIN_EMAIL=superadmin@opd.local
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_NAME=Super Admin

# ── Database (PostgreSQL) ────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=OPD
DATABASE_SSL=false
DATABASE_LOGGING=false

# ── AWS S3 ───────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_URL_PREFIX=
AWS_S3_BASE_FOLDER=
AWS_S3_APP_FOLDER=opd

# ── Uploads ──────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=5

# ── Booking ──────────────────────────────────────────
BOOKING_WINDOW_DAYS=7

# ── Rate limiting (public booking) ───────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=20

# ── Local AI sidecar (see ../ai-OPD) ─────────────────
# Must stay on localhost — the sidecar has no auth of its own.
AI_SERVICE_URL=http://127.0.0.1:8000
# Transcribing a long consultation on CPU takes minutes, hence the wide timeout.
AI_TIMEOUT_SECONDS=900
# Set to false to run with no AI: uploads and consultations still work, they
# simply produce no summary or draft prescription.
AI_ENABLED=true
