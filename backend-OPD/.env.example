# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
CLINIC_TIMEZONE=Asia/Kolkata
# Prescription letterhead (all optional — blank clinic name falls back to
# the doctor's name).
CLINIC_NAME=
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_EMAIL=

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# ── SuperAdmin seed ──────────────────────────────────
SUPERADMIN_EMAIL=superadmin@opd.local
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_NAME=Super Admin

# ── Database (PostgreSQL) ────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=OPD
DATABASE_SSL=false
DATABASE_LOGGING=false

# ── AWS S3 ───────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_URL_PREFIX=
AWS_S3_BASE_FOLDER=
AWS_S3_APP_FOLDER=opd

# ── Uploads ──────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=5

# ── Booking ──────────────────────────────────────────
BOOKING_WINDOW_DAYS=7

# ── Rate limiting (public booking) ───────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300

# ── Local AI sidecar (see ../ai-OPD) ─────────────────
# Must stay on localhost — the sidecar has no auth of its own.
AI_SERVICE_URL=http://127.0.0.1:8000
# Transcribing a long consultation on CPU takes minutes, hence the wide timeout.
AI_TIMEOUT_SECONDS=900
# Set to false to run with no AI: uploads and consultations still work, they
# simply produce no summary or draft prescription.
AI_ENABLED=true
# Live transcription over a WebSocket (`/consultation` namespace on the API
# host, socket.io path `/socket.io/`) while the doctor is still talking. Set
# false to turn it off: the recorder notices the refused socket and uploads
# the whole recording when the doctor stops, as before — no client change.
#
# A reverse proxy in front of the API must pass WebSocket upgrades on
# /socket.io/ — for nginx:
#   location /socket.io/ {
#     proxy_pass http://127.0.0.1:3000;
#     proxy_http_version 1.1;
#     proxy_set_header Upgrade $http_upgrade;
#     proxy_set_header Connection "upgrade";
#     proxy_read_timeout 600s;
#   }
# Sessions are held in memory on the instance that accepted the socket, so
# run one API instance (or add the socket.io Redis adapter before scaling out).
CONSULTATION_STREAMING=true
# How many pieces of one live recording may be transcribed at the same time.
# 1 is the original behaviour and the right one for a Whisper sidecar: the
# pieces were chained and would only queue behind one model anyway. With the
# sidecar on STT_PROVIDER=sarvam the calls are independent and network-bound,
# so serialising them is pure waiting — set 4.
CONSULTATION_PARALLEL_CHUNKS=1

# ── Admin web app (sign-in link in the email a new team member receives) ──
ADMIN_WEB_BASE=http://localhost:5173
# ── This API as patients reach it (the prescription link sent over WhatsApp) ──
API_PUBLIC_BASE=http://localhost:3000/api

# ── Outgoing email (verification codes, password resets, staff credentials) ──
# Leave MAIL_USER empty to log messages instead of sending them.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM="myDigitalOPD <no-reply@example.com>"

# ── WhatsApp Cloud API (patient sign-up OTP) ─────────
# Leave WA_ACCESS_TOKEN empty to log the code instead of sending it.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_APP_ID=
WA_APP_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WA_API_VERSION=v21.0
# Prefixed to the 10-digit number the patient types (E.164 without the +).
WA_COUNTRY_CODE=91
# The approved AUTHENTICATION template ("*{{1}}* is your verification code…")
# with a Copy Code button, and its language.
WA_OTP_TEMPLATE_NAME=verify_code
WA_OTP_TEMPLATE_LANG=en_US
