# Base URL of the OPD backend API (include the /api prefix, no trailing slash).
#
# Local dev examples:
# - iOS simulator & desktop: http://localhost:3000/api
# - Android emulator:        http://10.0.2.2:3000/api
# - Real device:             http://<your-machine-LAN-IP>:3000/api
# - Dev tunnel (public):     https://<subdomain>.devtunnels.ms/api
API_BASE_URL=http://localhost:3000/api
